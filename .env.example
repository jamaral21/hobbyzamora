# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hobbyzamora?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Getnet Chile (PlacetoPay) Web Checkout
GETNET_ENDPOINT=https://checkout.test.getnet.cl
GETNET_LOGIN=your-login
GETNET_TRANKEY=your-trankey
# sandbox = https://checkout.test.getnet.cl
# production = https://checkout.getnet.cl

# Frontend URL (for payment return redirects)
FRONTEND_URL=http://localhost:5173

# Instagram API (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_BUSINESS_ID=your-instagram-business-id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
